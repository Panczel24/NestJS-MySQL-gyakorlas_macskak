<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <title>macskakeresés</title>
</head>

<body>
    <a href="/">index</a>

    <form method="get">
        <input type="text" name="szemszin" value="<%= szemszin %>" placeholder="keresés szemszín alapján">
        <button type="submit">Keresés</button>

    </form>

    <table>
        <thead>
            <tr>
                <td>id</td>
                <td>suly</td>
                <td>szem_szin</td>
                <td>gazdi_id</td>
                <td>jatek_id</td>
            </tr>
        </thead>
        <tbody>
            <% for( let macska of macskak) { %>
                <tr>
                    <td>
                        <%= macska.id %>
                    </td>
                    <td>
                        <%= macska.suly %>
                    </td>
                    <td>
                        <%= macska.szem_szin %>
                    </td>
                    <td>
                        <%= macska.gazdi_id %>
                    </td>
                    <td>
                        <%= macska.jatek_id %>
                    </td>
                </tr>
                <% } %>
        </tbody>
    </table>



</body>

</html>